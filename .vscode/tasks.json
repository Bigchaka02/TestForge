{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "label": "npm: build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$esbuild"
    },
    {
      "type": "npm",
      "script": "watch",
      "label": "npm: watch",
      "isBackground": true,
      "problemMatcher": "$esbuild-watch"
    },
    {
      "label": "compile extension tests",
      "type": "shell",
      "command": "npx tsc -p test/extension",
      "problemMatcher": "$tsc"
    },
    {
      "label": "build extension tests",
      "dependsOn": ["npm: build", "compile extension tests"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
